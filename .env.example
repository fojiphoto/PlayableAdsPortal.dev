# Production env for @forge/server. Copy to .env and fill in.
NODE_ENV=production
PORT=4000

# REQUIRED in production. Generate a strong value:
#   openssl rand -base64 48
JWT_SECRET=

# sqlite file — put it on a persistent disk/volume
FORGE_DB=/data/forge.db

# max upload size in bytes (default 50MB)
MAX_UPLOAD_BYTES=52428800

# OPTIONAL: only when the web SPA is hosted separately from the API
# (e.g. SPA on Pinehoster + CDN, API on an external host). Build the web with:
#   VITE_API_BASE=https://api.factorialstudio.dev npm run build -w @forge/web
# Leave unset for the default single-origin deploy.
# VITE_API_BASE=

# ── Stripe billing (OPTIONAL) ──────────────────────────────────────────────
# Leave these unset to keep billing in dev mode (plans switch instantly, no card).
# When set, upgrades go through Stripe Checkout and plan changes are driven by the webhook.
#   1. Create two recurring Prices in the Stripe dashboard (Starter $49/mo, Studio $199/mo).
#   2. Add a webhook endpoint → https://app.factorialstudio.dev/api/billing/webhook
#      subscribed to: checkout.session.completed, customer.subscription.updated,
#      customer.subscription.deleted. Copy its signing secret into STRIPE_WEBHOOK_SECRET.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_STUDIO=price_...
# Absolute SPA base URL for Checkout return links (used only if the request Origin is missing):
# PUBLIC_URL=https://app.factorialstudio.dev
