{
  "name": "playableadsportal",
  "version": "0.1.0",
  "private": true,
  "description": "One build in, a correct playable ad per network out. Monorepo root.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "packager:test": "npm run test -w @forge/packager"
  },
  "engines": {
    "node": ">=20"
  }
}
