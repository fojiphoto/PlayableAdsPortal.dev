{
  "name": "@forge/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fastify REST API \u2014 upload HTML5 playable \u2192 pack \u2192 export \u2192 download, on top of @forge/packager.",
  "main": "./src/server.ts",
  "scripts": {
    "dev": "node --import tsx --watch src/server.ts",
    "start": "node --import tsx src/server.ts",
    "build": "tsup src/server.ts --format esm --clean",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:to-postgres": "node --import tsx src/scripts/migrate-to-postgres.ts",
    "blobs": "node --import tsx src/scripts/blobs.ts",
    "test:pg": "vitest run -c vitest.pg.config.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/static": "^8.1.1",
    "@forge/packager": "*",
    "aws4fetch": "^1.0.20",
    "fastify": "^5.1.0",
    "jszip": "^3.10.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.23.1",
    "form-data": "^4.0.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
